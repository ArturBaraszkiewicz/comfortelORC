# Copy to /etc/comfortel-orchestrator.env; do not commit credentials.
LOCAL_ORCHESTRATOR_PUBLIC_URL=https://orchestrator.example.com
LOCAL_ORCHESTRATOR_DATA=/var/lib/comfortel-orchestrator/data

# Optional restriction on repository hosts; comma-separated names, no scheme.
COMFORTEL_GIT_HOSTS=git.example.com

# Jira Server / Data Center: personal access token (Bearer), email empty, API v2.
# Jira Cloud: email + API token (Basic), API v3.
COMFORTEL_JIRA_URL=
COMFORTEL_JIRA_TOKEN=
COMFORTEL_JIRA_EMAIL=
COMFORTEL_JIRA_API_VERSION=2

# Optional native CLI executable paths if they are not in the service PATH.
# LOCAL_ORCHESTRATOR_CLAUDE_BIN=/var/lib/comfortel-orchestrator/.local/bin/claude
# LOCAL_ORCHESTRATOR_CODEX_BIN=/usr/local/bin/codex
